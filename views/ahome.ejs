<script>

    //Modal Script (Popup)
    window.onclick = function (event) {
        var cloginModal = document.getElementById('cloginform');
        var aloginModal = document.getElementById('aloginform');
        var aloginModal = document.getElementById('csignupform');
        if (event.target == cloginModal) {
            cloginModal.style.display = "none";
        } else if (event.target == aloginModal) {
            aloginModal.style.display = "none";
        }
    }


    //Signup Password Validation script
    function validateForm() {
            var password1 = document.getElementById("signup-password1").value;
            var password2 = document.getElementById("signup-password2").value;

            if (password1 !== password2) {
                // Passwords do not match, show error message
                document.getElementById("password-match-message").style.display = "block";
                return false; // Prevent form submission
            } else {
                // Passwords match, hide error message
                document.getElementById("password-match-message").style.display = "none";
                return true; // Allow form submission
            }
        }


    var prevScrollpos = window.pageYOffset;
    var header = document.getElementById("headerbar");
    var headerHeight = header.offsetHeight;
    window.onscroll = function() {
    var currentScrollPos = window.pageYOffset;
    if (prevScrollpos > currentScrollPos) {
        document.getElementById("headerbar").style.top = "0";
    } else {
        document.getElementById("headerbar").style.top = `${6-headerHeight}px`;
    }
    prevScrollpos = currentScrollPos;
    }

    console.log(headerHeight)


// Function for Onload Login Popup
window.onload = function() {
    setTimeout(function() {
        if (!sessionStorage.getItem('popupShown')) {
            // Show the popup if it hasn't been shown in this session
            document.getElementById("cloginform").style.display = "block";
        }
    }, 2000); // Delay of 2000 milliseconds (2 seconds)
};

// Function to close the popup
function closePopup() {
    document.getElementById("cloginform").style.display = "none";
    // Set a flag in sessionStorage to prevent the popup from showing again in this session
    sessionStorage.setItem('popupShown', 'true');
}


    let slideIndex = 0;
    let slideInterval;

    // Function to start the carousel
    function startCarousel() {
        clearInterval(slideInterval); // Clear any existing interval to prevent multiple intervals
        showSlides();
        slideInterval = setInterval(showSlides, 3000); // Auto-slide every 3 seconds
    }

    // Function to display the current slide
    function showSlides() {
        let slides = document.getElementsByClassName("mySlides");

        // Hide all slides
        for (let i = 0; i < slides.length; i++) {
            slides[i].style.display = "none";
        }

        // Increment slide index
        slideIndex++;

        // Reset index if it exceeds the number of slides
        if (slideIndex > slides.length) { slideIndex = 1; }

        // Show the current slide
        slides[slideIndex - 1].style.display = "block";
    }

    // Function to trigger the file input for uploading a new slide image
    function openFileUpload() {
        document.getElementById('uploadImage').click();
    }

    // Function to add a new slide after uploading an image
    function addSlide() {
        let fileInput = document.getElementById('uploadImage');
        let newImageSrc = URL.createObjectURL(fileInput.files[0]);

        // Create a new slide div
        let newSlideDiv = document.createElement('div');
        newSlideDiv.classList.add('mySlides', 'fade');

        // Add the image to the new slide div
        newSlideDiv.innerHTML = `<img src="${newImageSrc}" alt="New Slide">`;

        // Append the new slide to the carousel
        document.querySelector('.carousel').insertBefore(newSlideDiv, document.querySelector('.prev'));

        // Reset the input field
        fileInput.value = '';

        // Restart the carousel to include the new slide
        slideIndex = document.getElementsByClassName('mySlides').length - 1;
        startCarousel();
    }

    // Function to remove the current slide
    function removeCurrentSlide() {
        let slides = document.getElementsByClassName("mySlides");
        if (slides.length > 1) {
            slides[slideIndex - 1].remove(); // Remove the currently visible slide
            slideIndex--; // Adjust index to reflect removal
            if (slideIndex >= slides.length) {
                slideIndex = slides.length - 1;
            }
            startCarousel(); // Restart carousel with remaining slides
        } else {
            alert("Cannot delete the last slide.");
        }
    }

    // Start the carousel when the page loads
    window.onload = startCarousel;


</script>

